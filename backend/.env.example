PORT=4000
FRONTEND_URL=http://localhost:3000
# Local Prisma Postgres. Use a hosted PostgreSQL URL when deploying.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Optional direct connection for hosted migrations. Runtime uses DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
# Only used by migrate dev, never by the application or migrate deploy.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:51215/template1?sslmode=disable"
